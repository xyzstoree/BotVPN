# ============================================================
#  XYZSTORE MERGED BOT — .env
#  Salin file ini jadi `.env` lalu isi nilainya.
#  Konfigurasi VPN tetap di `vpn/.vars.json` (format lama).
# ============================================================

# ---- Telegram bot ----
BOT_TOKEN=123456789:AA....

# Port Express utama (default 6969). Webhook PPOB nempel ke server yang sama.
PORT=6969

# Komma-separated list. Dipakai modul PPOB (admin commands).
ADMIN_IDS=123456789,987654321

# Group ID(s) tempat log transaksi PPOB dikirim
PPOB_GROUP_IDS=-1001234567890

# Level log PPOB (ERROR | WARN | INFO | DEBUG)
LOG_LEVEL=INFO

# ---- Digiflazz (PPOB) ----
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_APIKEY=
# 'true' untuk testing mode
DIGIFLAZZ_TESTING=false
DIGIFLAZZ_WEBHOOK_SECRET=
# Tidak dipakai lagi (webhook nempel di PORT utama),
# disisakan untuk kompatibilitas script lama.
DIGIFLAZZ_WEBHOOK_PORT=8787
SYNC_INTERVAL_MENIT=30

# ---- AutoGoPay (QRIS PPOB) ----
AUTOGOPAY_API_KEY=
AUTOGOPAY_TOKEN=
DATA_QRIS=

# ---- QRIS expire setting (PPOB, dalam menit) ----
QRIS_EXPIRE_MIN=10
QRIS_EXPIRE_MIN_TOPUP=10
QRIS_EXPIRE_MIN_DIRECT=10
QRIS_LIMIT_PER_HARI=20

# ---- Sidompul / Indosat cek kuota ----
SIDOMPUL_API_KEY=

# ---- PPOB markup default (Rp) ----
MARKUP_HARGA=500

# ---- Redis (opsional, untuk session PPOB) ----
REDIS_URL=
